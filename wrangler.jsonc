{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joshpaulpopkin",
  "main": "worker.js",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "triggers": { "crons": ["5 * * * *"] }
  // Custom domains removed 2026-09-18: the domain is served DNS-only from GitHub Pages
  // (gh-pages branch) because Wix's Cloudflare-for-SaaS hostname claim outranks a proxied
  // record on this zone. workers.dev stays on as a preview. See README.
}
