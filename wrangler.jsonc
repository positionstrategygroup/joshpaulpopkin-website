{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joshpaulpopkin",
  "main": "worker.js",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "triggers": { "crons": ["5 * * * *"] },
  "routes": [
    { "pattern": "joshpaulpopkin.com", "custom_domain": true },
    { "pattern": "www.joshpaulpopkin.com", "custom_domain": true }
  ]
}
